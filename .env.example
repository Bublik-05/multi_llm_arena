# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_JUDGE_MODEL=qwen3
REQUEST_TIMEOUT=120
CONNECT_TIMEOUT=5

# --- Database (sync-style URL; the app converts it to the async driver) ---
DATABASE_URL=sqlite:///./arena.db

# --- Limits ---
MAX_MODELS=6
MAX_PROMPT_CHARS=8000
MAX_CONCURRENCY=4
PARTICIPANT_MAX_TOKENS=2048
JUDGE_NUM_CTX=8192
JUDGE_MAX_TOKENS=1024

# --- App ---
LOG_LEVEL=INFO
# JSON list
CORS_ORIGINS=["http://localhost:5173"]
